[Unit]
Description=MyDNS IPv4 updater
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=simple
User=mydns-updater
Group=mydns-updater
RuntimeDirectory=mydns-updater
RuntimeDirectoryMode=0700
Environment=MYDNS_HEALTH_FILE=/run/mydns-updater/health
Environment=MYDNS_CONFIG_DIR=/etc/mydns-updater
Environment=MYDNS_STATE_DIR=/var/lib/mydns-updater
ExecStart=/bin/sh /usr/local/lib/mydns-updater/update.sh
Restart=on-failure
RestartSec=600
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
